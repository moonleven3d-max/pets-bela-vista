rules_version = '2';
// Pets Bela Vista — regras completas do Cloud Firestore
// Publique este arquivo inteiro em: Firebase Console > Firestore Database > Regras.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid == "9DorSyAFJEdAkrtzjMxjLDst0sa2"; }
    function memberDoc() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    // Morador aprovado pela administração (WhatsApp confirmado no grupo do bairro): vê contatos e envia avistamentos.
    function isMember() { return signedIn() && exists(memberDoc()) && get(memberDoc()).data.active == true; }
    // Morador aprovado OU aguardando aprovação: já pode cadastrar e cuidar dos próprios pets.
    function isResident() { return signedIn() && exists(memberDoc()) && (get(memberDoc()).data.active == true || get(memberDoc()).data.status == "pending"); }
    function incoming() { return request.resource.data; }
    function isOwnerOf(res) { return signedIn() && res.data.ownerUid == request.auth.uid; }
    function keepsOwner() { return incoming().ownerUid == request.auth.uid; }
    function shortText(field, max) { return !(field in incoming()) || (incoming()[field] is string && incoming()[field].size() <= max); }
    function petOwnedByMe(petId) {
      return exists(/databases/$(database)/documents/pets_public/$(petId)) &&
             get(/databases/$(database)/documents/pets_public/$(petId)).data.ownerUid == request.auth.uid;
    }

    // ---------- Moradores ----------
    // Cadastro individual: nasce "pending"; a administração aprova após conferir o WhatsApp no grupo do bairro.
    match /members/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
                    && incoming().active == false && incoming().status == "pending"
                    && incoming().keys().hasOnly(["name", "phone", "active", "status", "createdAt"])
                    && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 70
                    && incoming().phone is string && incoming().phone.size() <= 20;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }

    // ---------- Pets (perfil público: sem telefone e sem endereço) ----------
    function validPublicPet() {
      return incoming().keys().hasOnly(["name", "type", "sex", "neutered", "breed", "size", "traits", "description", "photo", "ownerUid", "createdAt", "updatedAt"])
          && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 40
          && incoming().type in ["Cachorro", "Gato", "Outro"]
          && shortText("sex", 10) && shortText("neutered", 10) && shortText("breed", 50) && shortText("size", 20) && shortText("traits", 180) && shortText("description", 240)
          && shortText("photo", 900000);
    }
    match /pets_public/{id} {
      allow read: if true;
      allow create: if isAdmin() || (isResident() && keepsOwner() && validPublicPet());
      allow update: if isAdmin() || (isResident() && isOwnerOf(resource) && keepsOwner() && validPublicPet());
      allow delete: if isAdmin() || (isResident() && isOwnerOf(resource));
    }

    // ---------- Contatos dos responsáveis (somente moradores conectados) ----------
    // Lido por moradores quando o responsável autorizou (allowAlerts), pelo próprio dono e pela administração.
    match /pet_alert_contacts/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.allowAlerts == true) || (isResident() && isOwnerOf(resource));
      allow create: if isAdmin() || (isResident() && keepsOwner()
                    && incoming().keys().hasOnly(["petId", "petName", "guardians", "allowAlerts", "ownerUid"])
                    && incoming().guardians is list && incoming().guardians.size() <= 3
                    && incoming().allowAlerts is bool);
      allow update: if isAdmin() || (isResident() && isOwnerOf(resource) && keepsOwner()
                    && incoming().keys().hasOnly(["petId", "petName", "guardians", "allowAlerts", "ownerUid"])
                    && incoming().guardians is list && incoming().guardians.size() <= 3
                    && incoming().allowAlerts is bool);
      allow delete: if isAdmin() || (isResident() && isOwnerOf(resource));
    }

    // ---------- Endereço / referências da casa (privado: dono e administração) ----------
    match /pet_private/{id} {
      allow read: if isAdmin() || isOwnerOf(resource);
      allow create: if isAdmin() || (isResident() && keepsOwner()
                    && incoming().keys().hasOnly(["petId", "ownerUid", "street", "number", "referenceUnit", "houseColor", "nearbyReference"]));
      allow update: if isAdmin() || (isResident() && isOwnerOf(resource) && keepsOwner()
                    && incoming().keys().hasOnly(["petId", "ownerUid", "street", "number", "referenceUnit", "houseColor", "nearbyReference"]));
      allow delete: if isAdmin() || (isResident() && isOwnerOf(resource));
    }

    // ---------- Alertas de desaparecimento ----------
    // O próprio responsável publica e encerra o alerta do seu pet (id do documento = id do pet).
    match /lost_public/{id} {
      allow read: if true;
      allow create: if isAdmin() || (isResident() && keepsOwner() && incoming().status == "active"
                    && incoming().petId == id && petOwnedByMe(id)
                    && shortText("location", 140) && shortText("notes", 400) && shortText("photo", 900000));
      allow update: if isAdmin() || (isResident() && isOwnerOf(resource) && keepsOwner()
                    && incoming().petId == resource.data.petId
                    && incoming().status in ["active", "resolved"]
                    && shortText("location", 140) && shortText("notes", 400) && shortText("photo", 900000));
      allow delete: if isAdmin();
    }

    // ---------- Avistamentos de pets cadastrados ----------
    match /sightings/{id} {
      allow create: if isMember() && incoming().reporterUid == request.auth.uid
                    && shortText("location", 140) && shortText("notes", 300);
      allow read: if isAdmin() || (signedIn() && resource.data.petOwnerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---------- Animais encontrados na rua ----------
    match /found_public/{id} {
      allow read: if isAdmin() || resource.data.status == "active";
      allow create, update, delete: if isAdmin();
    }
    match /found_submissions/{id} {
      allow create: if incoming().status == "pending"
                    && shortText("location", 120) && shortText("traits", 180) && shortText("photo", 900000);
      allow read, update, delete: if isAdmin();
    }

    // ---------- Reivindicações ----------
    match /claim_submissions/{id} {
      allow create: if incoming().status == "pending" && shortText("proof", 500);
      allow read, update, delete: if isAdmin();
    }

    // ---------- Coleções antigas (somente leitura/limpeza pela administração) ----------
    match /pet_submissions/{id} { allow read, update, delete: if isAdmin(); }
    match /lost_submissions/{id} { allow read, update, delete: if isAdmin(); }
  }
}
